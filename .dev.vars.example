# Copy this file to `.dev.vars` (gitignored) and fill in your real values for local dev.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used to generate the AI recommendation panel shown alongside assessment
# results (result screen, PDF report, admin panel). If unset, submissions
# are saved without a recommendation instead of failing.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the default model (claude-sonnet-5) used for that call.
# ANTHROPIC_MODEL=claude-sonnet-5

# Postgres connection (used by db/index.ts)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Password to access /quan-tri (the registrations admin list)
ADMIN_PASSWORD=change_me

# Secret used to sign the email-OTP tokens for /danh-gia (any long random
# string). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SECRET=change_me_to_a_long_random_string

# Base URL the server uses to call its own API routes from Server
# Components (must match the port `npm run dev` actually listens on).
APP_ORIGIN=http://127.0.0.1:3000
